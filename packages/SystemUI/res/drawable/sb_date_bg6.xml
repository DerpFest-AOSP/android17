<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient light: two-layer gradient with distinct hues (accent1 → accent3) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270.0"
                android:startColor="@android:color/system_accent1_300"
                android:endColor="@android:color/system_accent3_300" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:end="3dp"
        android:start="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90.0"
                android:startColor="@android:color/system_accent1_300"
                android:endColor="@android:color/system_accent3_300" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
