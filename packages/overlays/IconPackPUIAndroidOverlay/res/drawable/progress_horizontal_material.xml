<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill_horizontal|center" android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <size android:height="8dp" />
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="?android:colorControlActivated" />
        </shape>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/secondaryProgress">
        <clip>
            <selector>
                <item android:state_enabled="false" android:drawable="@android:color/transparent" />
                <item>
                    <shape android:shape="rectangle">
                        <corners android:radius="8dp" />
                        <size android:height="8dp" />
                        <solid android:color="?android:colorControlActivated" />
                        <stroke android:width="2dp" android:color="?android:colorControlActivated" />
                    </shape>
                </item>
            </selector>
        </clip>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/progress">
        <clip>
            <selector>
                <item android:state_enabled="false" android:drawable="@android:color/transparent" />
                <item>
                    <shape android:shape="rectangle">
                        <corners android:radius="8dp" />
                        <size android:height="4dp" />
                        <stroke android:width="2dp" android:color="?android:colorControlActivated" />
                        <gradient
                            android:startColor="?android:colorControlActivated"
                            android:endColor="?android:colorControlActivated"
                            android:angle="45"
                            android:type="linear" />
                    </shape>
                </item>
            </selector>
        </clip>
    </item>
</layer-list>
